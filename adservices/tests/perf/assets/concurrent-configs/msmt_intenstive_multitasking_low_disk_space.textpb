# Intensive Multitasking with Low Disk Space
# Expectations: CUJs may experience slowdowns or errors due to resource constraints. Disk write failures are possible. System responsiveness may be impacted.
# Index based example schedule
schedule: INDEXED
scenarios [
  {
    index: 0
